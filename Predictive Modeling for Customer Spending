        "# Tuned k-NN"
      ],
      "metadata": {
        "id": "OmkaDDVpjLDO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# n_neighbors = number of neighbors (k)\n",
        "# weights     = \"uniform\" (all neighbors equal) or \"distance\" (closer neighbors count more)\n",
        "# p           = distance metric (1 = Manhattan, 2 = Euclidean)\n",
        "knn_pipe = Pipeline([\n",
        "    (\"scaler\", StandardScaler()),\n",
        "    (\"knn\", KNeighborsRegressor())\n",
        "])\n",
        "\n",
        "knn_params = {\n",
        "    \"knn__n_neighbors\": list(range(3, 41, 2)),\n",
        "    \"knn__weights\": [\"uniform\", \"distance\"],\n",
        "    \"knn__p\": [1, 2]\n",
        "}\n",
        "\n",
        "knn_grid = GridSearchCV(\n",
        "    knn_pipe, knn_params, cv=10,\n",
        "    scoring=\"neg_root_mean_squared_error\", n_jobs=-1\n",
        ")\n",
        "knn_grid.fit(X_fe, y_fe)\n",
        "\n",
        "print(\"Best k-NN parameters:\", knn_grid.best_params_)\n",
        "print(\"Best CV RMSE: %0.2f\" % -knn_grid.best_score_)\n",
        "\n",
        "knn_res = pd.DataFrame(knn_grid.cv_results_)\n",
