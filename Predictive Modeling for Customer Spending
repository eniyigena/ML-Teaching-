      "source": [
        "# Make a copy of the original data\n",
        "df_fe = df.copy()\n",
        "\n",
        "# 1. Nonlinear transformation of transaction frequency\n",
        "df_fe[\"sqrt_Freq\"] = np.sqrt(df_fe[\"Freq\"])\n",
        "\n",
        "# 2. Combine transaction frequency and recency\n",
        "df_fe[\"recent_activity_score\"] = (\n",
        "    df_fe[\"Freq\"] /\n",
        "    (1 + df_fe[\"last_update_days_ago\"] / 365)\n",
        ")\n",
        "\n",
        "# 3. Interaction between frequency and residential address\n",
        "df_fe[\"Freq_x_Address\"] = (\n",
        "    df_fe[\"Freq\"] * df_fe[\"Address_is_res\"]\n",
        ")\n",
        "\n",
        "# Target variable\n",
        "y_fe = df_fe[\"Spending\"]\n",
