        "## **Part c) Parameter tuning**"
      ],
      "metadata": {
        "id": "KQmrbp3Iis1a"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.model_selection import GridSearchCV, cross_validate\n",
        "from sklearn.linear_model import ElasticNet, Ridge\n",
        "from sklearn.neighbors import KNeighborsRegressor\n",
        "from sklearn.tree import DecisionTreeRegressor\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.pipeline import Pipeline\n",
        "\n",
        "# Same feature set as Part B: 22 original predictors + 3 engineered features\n",
        "print(\"Number of predictors:\", X_fe.shape[1])\n",
        "print(list(X_fe.columns))\n",
        "\n",
        "# Helper: 10-fold CV RMSE and MAE for a final model\n",
        "def cv_report(name, model):\n",
        "    scores = cross_validate(\n",
        "        model, X_fe, y_fe, cv=10,\n",
        "        scoring=[\"neg_root_mean_squared_error\", \"neg_mean_absolute_error\"]\n",
        "    )\n",
        "    rmse = -scores[\"test_neg_root_mean_squared_error\"]\n",
        "    mae = -scores[\"test_neg_mean_absolute_error\"]\n",
        "    print(name)\n",
        "    print(\"RMSE: %0.2f (+/- %0.2f)\" % (rmse.mean(), rmse.std()))\n",
        "    print(\"MAE: %0.2f (+/- %0.2f)\" % (mae.mean(), mae.std()))\n",
        "    return rmse, mae"
      ],
