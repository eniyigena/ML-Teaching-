      "source": [
        "# Define target variable and predictors\n",
        "y = df[\"Spending\"]\n",
        "X = df.drop(columns=[\"Spending\", \"sequence_number\", \"Purchase\"])\n",
        "\n",
        "# Import libraries and modules\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.model_selection import cross_val_score\n",
        "\n",
        "# Initiate the linear regression model\n",
        "lr = LinearRegression()\n",
        "\n",
        "# 10-fold cross-validation using RMSE\n",
        "scores_rmse = cross_val_score(\n",
        "    estimator=lr,\n",
        "    X=X,\n",
        "    y=y,\n",
        "    cv=10,\n",
        "    scoring=\"neg_root_mean_squared_error\"\n",
        ")\n",
        "\n",
        "# Convert negative RMSE scores to positive values\n",
        "scores_rmse = -scores_rmse\n",
        "\n",
        "print(\"Linear Regression\")\n",
        "print(\"RMSE: %0.2f (+/- %0.2f)\"\n",
        "      % (scores_rmse.mean(), scores_rmse.std()))\n",
        "# 10-fold cross-validation using MAE\n",
        "scores_mae = cross_val_score(\n",
        "    estimator=lr,\n",
        "    X=X,\n",
        "    y=y,\n",
        "    cv=10,\n",
        "    scoring=\"neg_mean_absolute_error\"\n",
        ")\n",
        "\n",
        "scores_mae = -scores_mae\n",
        "\n",
        "print(\"MAE: %0.2f (+/- %0.2f)\"\n",
        "      % (scores_mae.mean(), scores_mae.std()))"
