      "source": [
        "# Tuned Linear Regression (regularized: Elastic Net / Ridge / Lasso)"
      ],
      "metadata": {
        "id": "PA4I2TdEi65H"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# alpha    = overall strength of the penalty\n",
        "# l1_ratio = mix between Ridge (L2) and Lasso (L1); l1_ratio = 1.0 is pure Lasso\n",
        "# Predictors are standardized so the penalty treats all coefficients equally\n",
        "enet_pipe = Pipeline([\n",
        "    (\"scaler\", StandardScaler()),\n",
        "    (\"enet\", ElasticNet(max_iter=50000, random_state=42))\n",
        "])\n",
        "\n",
        "enet_params = {\n",
        "    \"enet__alpha\": [0.001, 0.01, 0.05, 0.1, 0.5, 1, 2, 5, 10],\n",
        "    \"enet__l1_ratio\": [0.1, 0.3, 0.5, 0.7, 0.9, 1.0]\n",
        "}\n",
        "\n",
        "enet_grid = GridSearchCV(\n",
        "    enet_pipe, enet_params, cv=10,\n",
        "    scoring=\"neg_root_mean_squared_error\", n_jobs=-1\n",
        ")\n",
        "enet_grid.fit(X_fe, y_fe)\n",
        "\n",
        "print(\"Best Elastic Net parameters:\", enet_grid.best_params_)\n",
        "print(\"Best CV RMSE: %0.2f\" % -enet_grid.best_score_)\n",
        "\n",
        "enet_res = pd.DataFrame(enet_grid.cv_results_)\n",
        "enet_res[\"RMSE\"] = -enet_res[\"mean_test_score\"]\n",
        "enet_res[[\"param_enet__alpha\", \"param_enet__l1_ratio\", \"RMSE\"]] \\\n",
        "    .sort_values(\"RMSE\").head()"
