      }
    },
    {
      "cell_type": "code",
      "source": [
        "# This imports the train_test_split function from the scikit-learn library.\n",
        "# This function is used to randomly split datasets into training and test subsets.\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "\n",
        "# Set the dependent target variable (y).\n",
        "y = df[\"Diagnosis\"]\n",
        "\n",
        "# Simple Split Validation\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.20,\n",
        "    random_state=42,\n",
        "    stratify=y\n",
        ")\n"
      ],
      "metadata": {
        "id": "Un-7uXIUGt0d"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Target Variable Distribution"
      ],
