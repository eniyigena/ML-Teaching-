        "# Importing the StandardScaler class\n",
        "from sklearn.preprocessing import StandardScaler  #This use formula of standardiziation z=s-u/s\n",
        "\n",
        "# Instantiate StandardScaler\n",
        "sc = StandardScaler()\n",
        "# Fitting the StandardScaler\n",
        "sc.fit(X_train)\n",
        "\n",
        "# Transforming the datasets\n",
        "X_train_std = sc.transform(X_train) # This line uses the transform method of the sc object to standardize the features in the training set.\n",
        "\n",
        "X_test_std = sc.transform(X_test)   # Similarly, this line standardizes the features in the testing set.\n"
