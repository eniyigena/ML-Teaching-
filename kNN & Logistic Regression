        "id": "nZ2KJRBuZAwc"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "db9fbf20"
      },
      "source": [
        "y_numeric = df['Diagnosis'].map({'M': 1, 'B': 0})\n",
        "\n",
        "X_train, X_test, y_train_numeric, y_test_numeric = train_test_split(\n",
        "    X,\n",
        "    y_numeric,\n",
        "    test_size=0.20,\n",
        "    random_state=42,\n",
        "    stratify=y_numeric\n",
        ")"
      ],
