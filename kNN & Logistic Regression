    {
      "cell_type": "code",
      "source": [
        "\n",
        "# Import the neighbors module from scikit-learn\n",
        "from sklearn import neighbors\n",
        "\n",
        "# The KNeighborsClassifier applies the k-nearest neighbors algorithm for classification.\n",
        "# It predicts the class of a new observation based on the classes of nearby observations.\n",
        "\n",
        "# Create the k-NN classifier\n",
        "knn_model = neighbors.KNeighborsClassifier(\n",
        "\n",
        "    n_neighbors=3,          # Sets k = 3, so the model uses the 3 closest observations\n",
        "                            # when deciding the class of a new observation.\n",
        "\n",
        "    p=2,                    # Specifies the power parameter for the Minkowski distance.\n",
        "                            # When p = 2, Minkowski distance becomes Euclidean distance.\n",
        "\n",
        "    metric='minkowski',     # Uses Minkowski distance to measure how close observations are.\n",
        "                            # With p = 2, this is equivalent to Euclidean distance.\n",
        "\n",
        "    n_jobs=-1,              # Uses all available processor cores when searching for neighbors.\n",
        "\n",
        "    weights='uniform'       # Gives each of the 3 nearest neighbors the same voting weight/power.\n",
        ")\n",
        "\n",
        "# Fit the k-NN model using the standardized training predictors and training target\n",
        "knn_model.fit(X_train_std, y_train)"
