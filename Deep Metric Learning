        "# DO NOT MODIFY THIS PART\n",
        "class TestLoader(torchvision.datasets.ImageFolder):\n",
        "    def __init__(\n",
        "            self,\n",
        "            root: str,\n",
        "            transform = None,\n",
        "            target_transform = None,\n",
        "            is_valid_file = None,\n",
        "    ):\n",
        "        super(TestLoader, self).__init__(root=root,\n",
        "                                               transform=transform,\n",
        "                                               target_transform=target_transform,\n",
        "                                               is_valid_file=is_valid_file)\n",
        "        self.pairs = self.get_pairs()\n",
        "\n",
        "    def get_pairs(self):\n",
        "        pairs = []\n",
        "        labels = list(self.class_to_idx.values())\n",
        "        targets = np.array(self.targets)\n",
        "        pos = [np.argwhere(targets == labels[i])[[0, -1]] for i in range(len(labels))]\n",
        "        for i in range(len(labels)):\n",
        "            i_a, i_p = np.random.choice(np.arange(pos[i][0], pos[i][1]+1), 2, replace=False)\n",
        "            pairs.append([i_a, i_p, int(i >= 100)])\n",
        "        return np.array(pairs)\n",
        "\n",
        "    def __len__(self):\n",
        "            return self.pairs.shape[0]\n",
        "\n",
        "    def __getitem__(self, index):\n",
        "        i = self.pairs[index]\n",
        "        a, a_target = self.samples[i[0]]\n",
        "        c, c_target = self.samples[i[1]]\n",
        "        img_a = self.loader(a)\n",
        "        img_c = self.loader(c)\n",
        "\n",
        "        if self.transform is not None:\n",
        "            img_a = self.transform(img_a)\n",
        "            img_c = self.transform(img_c)\n",
        "\n",
        "        return img_a, img_c, i[2]"
      ]
