        "def train(model, data_loader, test_loader, criterion, optimizer, n_epochs=1, scheduler=None):\n",
        "    model.train()\n",
        "\n",
        "    for epoch in range(n_epochs):\n",
        "        epoch_loss = 0\n",
        "        for anchor, positive, negative in data_loader:\n",
        "            anchor = anchor.to(device)\n",
        "            positive = positive.to(device)\n",
        "            negative = negative.to(device)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "\n",
        "            anchor_out = model(anchor)\n",
        "            positive_out = model(positive)\n",
        "            negative_out = model(negative)\n",
        "\n",
        "            loss = criterion(anchor_out, positive_out, negative_out)\n",
        "\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "\n",
        "            epoch_loss += loss.item()\n",
        "\n",
        "        epoch_loss /= len(data_loader)\n",
        "\n",
        "        if scheduler:\n",
        "            scheduler.step()\n",
        "\n",
        "        val_loss = validate(model, test_loader, criterion)\n",
        "        print(f\"Epoch {epoch+1}/{n_epochs}.. Train loss: {epoch_loss:.3f}.. Val loss: {val_loss:.3f}\")"
