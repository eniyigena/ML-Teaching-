        "\n",
        "#Starting with loading/Downloading data.\n",
        "dataset = pd.read_csv('CC GENERAL.csv')\n",
        "\n",
        "\"\"\"Let know handle the missing values in 'MINIMUM_PAYMENTS' and 'CREDIT_LIMIT'columns by NaN,then at same time fill those\n",
        "NaN by the mean of column's data.\"\"\"\n",
        "\n",
        "# Calculate the mean values for the specified columns.\n",
        "mean_credit_limit = dataset['CREDIT_LIMIT'].mean()\n",
        "mean_minimum_payments = dataset['MINIMUM_PAYMENTS'].mean()\n",
        "\n",
        "# Fill NaN values with mean values\n",
        "dataset['CREDIT_LIMIT'].fillna(mean_credit_limit, inplace=True)\n",
        "dataset['MINIMUM_PAYMENTS'].fillna(mean_minimum_payments, inplace=True)\n",
        "dataset  # This is now our dataset after removing all missing values.\n",
