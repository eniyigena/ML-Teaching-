        "import pandas as pd\n",
        "import numpy as np\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Assuming 'numeric_columns' is your list of numeric column names\n",
        "numeric_columns = dataset.select_dtypes(include=[np.number]).columns\n",
        "\n",
        "# Method to handle outliers\n",
        "def handle_outliers(numerical_columns, threshold=1.5, method='impute'):\n",
        "    Q25 = dataset[numerical_columns].quantile(0.25)\n",
        "    Q75 = dataset[numerical_columns].quantile(0.75)\n",
        "    IQR = Q75 - Q25\n",
        "    outliers = ((dataset[numerical_columns] < (Q25 - threshold * IQR)) |\n",
        "                (dataset[numerical_columns] > (Q75 + threshold * IQR)))\n",
        "\n",
        "    if method == 'remove':\n",
        "        # Remove outliers\n",
        "        data_no_outliers = dataset[~outliers.any(axis=1)]\n",
        "        return data_no_outliers\n",
        "    elif method == 'impute':\n",
        "        # Impute outliers with the median\n",
        "        for column in numerical_columns:\n",
        "            median_value = dataset[column].median()\n",
        "            outlier_mask = outliers[column]\n",
        "            dataset.loc[outlier_mask, column] = median_value\n",
        "        return dataset\n",
        "    else:\n",
        "        return dataset\n",
        "\n",
        "# Handle outliers (choose 'remove' or 'impute' as the method)\n",
        "credit_card_data_handled = handle_outliers(numeric_columns, method='impute')\n",
        "\n",
        "# Visualize correlation between numeric columns after handling outliers\n",
        "correlation_matrix_after = credit_card_data_handled[numeric_columns].corr()\n",
        "plt.figure(figsize=(15, 10))\n",
        "sns.heatmap(correlation_matrix_after, cmap='viridis', annot=True, fmt=\".3f\")\n",
        "plt.title(\"Correlation Matrix After Handling Outliers\")\n",
        "plt.show()"
