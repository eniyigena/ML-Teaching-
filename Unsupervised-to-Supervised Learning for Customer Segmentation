        "from sklearn.cluster import KMeans\n",
        "from sklearn.metrics import silhouette_score\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "import pickle\n",
        "import warnings\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "# Create an empty list to store silhouette scores for different values of k\n",
        "silhouette_scores = []\n",
        "\n",
        "# Iterate over a range of k values (from 2 to 20)\n",
        "for k in range(2, 21):\n",
        "    # Create a KMeans model with the current k value\n",
        "    kmeans_model = KMeans(n_clusters=k, init='k-means++', n_init=10, random_state=42)\n",
        "\n",
        "    # Fit the model to the dataset\n",
        "    cluster_labels = kmeans_model.fit_predict(dataset_scaled)\n",
        "\n",
        "    # Calculate the silhouette score\n",
        "    silhouette_avg = silhouette_score(dataset_scaled, cluster_labels)\n",
        "    silhouette_scores.append(silhouette_avg)\n",
        "\n",
        "# Plot the Silhouette Analysis curve\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(range(2, 21), silhouette_scores, marker='o', linestyle='-', color='b')\n",
        "plt.title('Silhouette Analysis for Optimal Clusters')\n",
        "plt.xlabel('Number of Clusters (k)')\n",
        "plt.ylabel('Silhouette Score')\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# Find the optimal number of clusters (k) based on the highest silhouette score\n",
        "optimal_k = silhouette_scores.index(max(silhouette_scores)) + 2\n",
        "\n",
        "# Print the number of optimal clusters (k)\n",
        "print(f'The optimal number of clusters (k) based on Silhouette Analysis is: {optimal_k}')\n",
        "\n",
        "# Create a KMeans model with the optimal k value\n",
        "optimal_kmeans_model = KMeans(n_clusters=optimal_k, init='k-means++', n_init=10, random_state=42)\n",
        "\n",
        "# Fit the model to the dataset\n",
        "optimal_cluster_labels = optimal_kmeans_model.fit_predict(dataset_scaled)\n",
        "\n",
        "# Add a new column to the original dataset to store the cluster labels\n",
        "dataset['Customer Segmentation'] = optimal_cluster_labels\n",
        "\n",
        "# Save the labeled dataset as a CSV file\n",
        "dataset.to_csv('neric-cc-labeled.csv', index=False)"
      ]
