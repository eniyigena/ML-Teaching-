        "plt.title(\"Correlation Matrix\")\n",
        "plt.xticks(range(len(numeric_columns)), numeric_columns, rotation='vertical')\n",
        "plt.yticks(range(len(numeric_columns)), numeric_columns)\n",
        "plt.show()\n"
