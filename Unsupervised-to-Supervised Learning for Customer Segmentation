        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.metrics import silhouette_score\n",
        "import pickle\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Extract features for clustering\n",
        "X = dataset_scaled\n",
        "\n",
        "# Use the Elbow Method to find the optimal number of clusters\n",
        "Sum_of_squared_distances = []\n",
        "K = range(2, 16)  # Try different numbers of clusters\n",
        "for k in K:\n",
        "    kmeans = KMeans(n_clusters=k, random_state=42)\n",
        "    kmeans.fit(X)\n",
        "    Sum_of_squared_distances.append(kmeans.inertia_)\n",
        "\n",
        "# Plot the elbow method results\n",
        "plt.plot(K, Sum_of_squared_distances, 'bx-')\n",
        "plt.xlabel('Number of Clusters (k)')\n",
        "plt.ylabel('Sum of Squared Distances')\n",
        "plt.title('Elbow Method For Optimal Number of Clusters')\n",
        "plt.show()\n",
        "\n",
        "# Choose the optimal number of clusters based on the elbow in the plot\n",
        "optimal_k = np.argmin(np.diff(Sum_of_squared_distances)) + 2\n",
        "\n",
        "# Build the K-means clustering model with the optimal number of clusters\n",
        "kmeans = KMeans(n_clusters=optimal_k, random_state=42)\n",
        "dataset['Cluster'] = kmeans.fit_predict(X)\n",
        "\n",
        "# Evaluate the clustering using silhouette score\n",
        "silhouette_avg = silhouette_score(X, dataset['Cluster'])\n",
        "print(f'Silhouette Score for {optimal_k} clusters: {silhouette_avg}')\n",
        "\n",
        "# Save the labeled dataset\n",
        "dataset.to_csv('neric-cc-labeled.csv', index=False)"
      ]
